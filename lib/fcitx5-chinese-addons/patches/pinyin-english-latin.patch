 im/pinyin/pinyin.cpp | 34 ++++++++++++++++++++++------------
 1 file changed, 22 insertions(+), 12 deletions(-)

diff --git a/im/pinyin/pinyin.cpp b/im/pinyin/pinyin.cpp
index 3e73a82..fcf5d9f 100644
--- a/im/pinyin/pinyin.cpp
+++ b/im/pinyin/pinyin.cpp
@@ -545,6 +545,19 @@ void PinyinEngine::updateUI(InputContext *inputContext) {
             selectedLength <= context.cursor()) {
             auto [hasUpper, engNess] =
                 englishNess(parsedPy, context.useShuangpin());
+            // Continuous latin buffer (e.g. "hello"): englishNess often returns 0
+            // because vowel-heavy tokens look like good pinyin. Still offer English.
+            const bool rawLatin =
+                !pyBeforeCursor.empty() &&
+                std::ranges::all_of(pyBeforeCursor, [](char c) {
+                    return charutils::isupper(c) || charutils::islower(c) ||
+                           c == '\'' || c == '-';
+                });
+            if (rawLatin && pyBeforeCursor.size() >= 2) {
+                // Ask for enough hints that a complete word surfaces near the top.
+                engNess = std::max<int>(
+                    engNess, std::max(8, static_cast<int>(pyBeforeCursor.size())));
+            }
             if (engNess) {
                 parsedPyCursor -= selectedSentence.length();
                 parsedPy = parsedPy.substr(
@@ -555,20 +568,17 @@ void PinyinEngine::updateUI(InputContext *inputContext) {
                 auto results = spell()->call<ISpell::hintWithProvider>(
                     "en", SpellProvider::Custom, pyBeforeCursor, engNess);
 
-                // Our hint doesn't work well with mixed case, so, always put a
-                // word as is.
-                if (hasUpper && !pyBeforeCursor.empty()) {
-                    if (std::find(results.begin(), results.end(),
-                                  pyBeforeCursor) == results.end()) {
-                        if (!charutils::isupper(pyBeforeCursor[0])) {
-                            results.insert(results.begin(), pyBeforeCursor);
-                        } else {
-                            results.push_back(pyBeforeCursor);
-                        }
-                    }
+                // Always offer the typed latin word first so a complete English
+                // word is selectable even when the dict ranking is weak.
+                if (!pyBeforeCursor.empty() && (hasUpper || rawLatin)) {
+                    results.erase(std::remove(results.begin(), results.end(),
+                                              pyBeforeCursor),
+                                  results.end());
+                    results.insert(results.begin(), pyBeforeCursor);
                 }
 
-                int position = hasUpper ? 0 : 1;
+                // Exact typed latin first (slot 0); Chinese stays alongside.
+                int position = (hasUpper || rawLatin) ? 0 : 1;
                 for (const auto &result : results) {
                     if (customCandidateMap.contains(result)) {
                         continue;
